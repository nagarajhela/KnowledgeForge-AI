# Application
APP_ENV=development
APP_NAME=KnowledgeForge AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security & Cryptography (Generate strong 32+ byte keys in production!)
SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes-secret
ENCRYPTION_KEY=change-me-fernet-base64-or-passphrase-for-provider-keys
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_AUTH_ENABLED=false

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://knowledgeforge:knowledgeforge@postgres:5432/knowledgeforge
DATABASE_SYNC_URL=postgresql+psycopg://knowledgeforge:knowledgeforge@postgres:5432/knowledgeforge
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
ENABLE_POSTGRES_RLS=false

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# S3 / MinIO Object Storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=knowledgeforge-documents
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50

# LLM & Embedding Providers
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# CORS & Frontend
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# OAuth2 (Google & Microsoft)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/microsoft/callback

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Malware Scanner (optional ClamAV daemon)
VIRUS_SCANNER_BACKEND=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
